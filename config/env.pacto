# EL PACTO — variables del stack (ver ../PLAN.md M0)
# Imágenes congeladas :pacto (snapshot de las arm64 ya compiladas; independiente
# de futuros rebuilds de La Torre). Volúmenes externos pacto-*.
COMPOSE_PROJECT_NAME=pacto
DOCKER_IMAGE_TAG=pacto
# (los volúmenes se renombran a pacto-* en el override, claves intactas)
# Puertos de El Pacto: MySQL/SOAP solo localhost; juego solo por Tailscale
DOCKER_DB_EXTERNAL_PORT=127.0.0.1:3307
DOCKER_WORLD_EXTERNAL_PORT=<TAILSCALE_IP>:8086
DOCKER_SOAP_EXTERNAL_PORT=127.0.0.1:7879
DOCKER_AUTH_EXTERNAL_PORT=<TAILSCALE_IP>:3725
